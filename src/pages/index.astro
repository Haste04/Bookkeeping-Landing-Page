---
/**
 * src/pages/index.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Landing page root. Imports the BaseLayout shell and composes all 7 sections
 * from src/components/. Each component is fully self-contained.
 *
 * To add, reorder, or remove a section — just move the line here.
 * ─────────────────────────────────────────────────────────────────────────────
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import ValueProp from "../components/ValueProp.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Seek First Books — Financial Clarity Meets Seamless Automation"
  description="Seek First Books automates your subscription revenue and customer reporting."
>
  <!-- Section 1 — Navigation -->
  <header class="sticky top-0 z-50">
    <NavBar />
  </header>

  <main>
    <!-- Section 1 — Hero -->
    <Hero />

    <!-- Section 2 — Features & Benefits -->
    <Features />

    <!-- Section 3 — Graphic Detail Value Proposition -->
    <ValueProp />

    <!-- Section 4 — Social Proof & Testimonials -->
    <Testimonials />

    <!-- Section 5 — FAQ / Handling Objections -->
    <FAQ />

    <!-- Section 6 — Final Call To Action -->
    <CTA />
  </main>

  <!-- Section 7 — Footer -->
  <Footer />
</BaseLayout>
