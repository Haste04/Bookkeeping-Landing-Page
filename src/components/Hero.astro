---
/**
 * src/components/Hero.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Section 1 — Hero Block.
 * Boutique aesthetic featuring a static lifestyle workspace background image
 * paired with an overlaying 2-image carousel loop cycling every 15 seconds.
 * ─────────────────────────────────────────────────────────────────────────────
 */
---

<div class="relative w-full overflow-hidden bg-[#FDFBF7]">
  <!-- Background Image & Blur Layer -->
  <div class="absolute inset-0 w-full h-full pointer-events-none z-0">
    <img
      src="/Hero/Hero Cover.jpg"
      alt=""
      class="w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-[#FDFBF7]/85 backdrop-blur-[2px]"></div>
  </div>

  <section
    id="hero"
    aria-labelledby="hero-headline"
    class="relative z-10 flex flex-col-reverse md:flex-row
      items-center justify-between
      gap-12 md:gap-8
      px-6 py-12
      md:px-12 lg:px-20
      md:py-16 lg:py-24
      max-w-screen-xl mx-auto"
  >
    <!-- Left Column: Content Block -->
    <div class="flex-1 max-w-xl hero-content">
      <h1
        id="hero-headline"
        class="hero-item text-4xl sm:text-5xl lg:text-6xl font-normal leading-[1.15] text-[#333D29] font-serif mb-6"
      >
        MORE THAN JUST <span class="italic text-[#A36A52]">THE NUMBERS</span>
      </h1>

      <p
        class="hero-item text-[#333D29]/75 text-base sm:text-lg text-justify leading-relaxed mb-8 max-w-md font-sans"
        style="animation-delay: 160ms;"
      >
        At Seek First Books, we believe your financial systems should bring
        peace of mind, not daily stress. Combining precise bookkeeping with
        streamlined technology integrations, we create organized financial
        systems that support sustainable business growth.
      </p>

      <div
        class="hero-item flex flex-col sm:flex-row sm:items-center gap-5"
        style="animation-delay: 300ms;"
      >
        <a
          href="#cta"
          class="inline-block text-center bg-[#A36A52] text-[#FDFBF7] font-medium text-sm tracking-wide
            px-8 py-3.5 hover:bg-[#8F5942] transition-colors duration-300
            rounded-tl-2xl rounded-br-2xl
            focus-visible:outline focus-visible:outline-2
            focus-visible:outline-offset-2 focus-visible:outline-[#A36A52]"
        >
          BOOK NOW
        </a>

        <p
          class="text-[#333D29]/70 text-xs sm:text-sm leading-snug font-sans max-w-[240px]"
        >
          Join local independent business owners who found clarity in their
          books.
        </p>
      </div>
    </div>

    <!-- Right Column: Carousel Frame -->
    <div
      class="hero-image flex-1 flex items-center justify-center w-full max-w-sm md:max-w-md lg:max-w-lg"
      aria-hidden="true"
    >
      <div
        class="relative w-full aspect-[4/5] sm:aspect-[1] md:aspect-[4/5] max-h-[480px]"
      >
        <!-- Decorative shadow offset layer -->
        <div
          class="absolute inset-0 bg-[#333D29]/5 rounded-bl-[4rem] rounded-tr-[4rem] transform translate-x-3 translate-y-3"
        >
        </div>

        <!-- Image frame -->
        <div
          class="absolute inset-0 bg-[#FEFEFE] rounded-tl-[6rem] rounded-br-[6rem] overflow-hidden border border-[#333D29]/10 shadow-sm"
        >
          <img
            src="/Hero/Hero 1.png"
            alt="Queenie's Bookkeeping lifestyle workspace scene"
            class="absolute inset-0 w-full h-full object-cover img-1"
          />
          <img
            src="/Hero/Hero 2.jpg"
            alt="Queenie's Bookkeeping client consultation detail"
            class="absolute inset-0 w-full h-full object-cover img-2"
          />
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  /* ─────────────────────────────────────────────────────────────────────────
   * PAGE LOAD ENTRY ANIMATIONS
   * ───────────────────────────────────────────────────────────────────────── */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-item {
    opacity: 0;
    animation: fadeUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  h1.hero-item {
    animation-delay: 0ms;
  }

  .hero-image {
    opacity: 0;
    animation: fadeUp 1.1s cubic-bezier(0.22, 1, 0.36, 1) 200ms forwards;
  }

  /* ─────────────────────────────────────────────────────────────────────────
   * 2-IMAGE CAROUSEL CROSSFADE TIMELINE (30s Total Loop)
   * 15 seconds per image means a full loop takes 30 seconds.
   * ───────────────────────────────────────────────────────────────────────── */

  /* img-1: Sits on top at start, crossfades out at mid-cycle, resets under early */
  @keyframes cycle-img-1 {
    0%,
    45% {
      opacity: 1;
      z-index: 10;
    }
    50%,
    95% {
      opacity: 0;
      z-index: 1;
    }
    100% {
      opacity: 1;
      z-index: 10;
    }
  }

  /* img-2: Sits underneath at start, crossfades in at 50%, stays up to secure the loop boundary drop */
  @keyframes cycle-img-2 {
    0%,
    45% {
      opacity: 0;
      z-index: 1;
    }
    50%,
    95% {
      opacity: 1;
      z-index: 5; /* Lower than img-1's returning z-index so img-1 layers cleanly on loop reset */
    }
    100% {
      opacity: 0;
      z-index: 1;
    }
  }

  .img-1 {
    animation: cycle-img-1 30s infinite ease-in-out;
  }
  .img-2 {
    animation: cycle-img-2 30s infinite ease-in-out;
  }
</style>
