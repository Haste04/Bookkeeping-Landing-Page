---
/**
 * src/components/Hero.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Section 1 — Hero Block.
 * Boutique aesthetic featuring a 4-image rotation cycling every 15 seconds.
 * Full-width background wrapper applied to prevent layout cropping on wide screens.
 * ─────────────────────────────────────────────────────────────────────────────
 */
---

<div class="w-full bg-[#FDFBF7]">
  <section
    id="hero"
    aria-labelledby="hero-headline"
    class="flex flex-col-reverse md:flex-row
      items-center justify-between
      gap-12 md:gap-8
      px-6 py-12
      md:px-12 lg:px-20
      md:py-16 lg:py-24
      max-w-screen-xl mx-auto"
  >
    <div class="flex-1 max-w-xl">
      <h1
        id="hero-headline"
        class="text-4xl sm:text-5xl lg:text-6xl font-normal leading-[1.15] text-[#333D29] font-serif mb-6"
      >
        For the woman building a business <span class="italic text-[#A36A52]"
          >for the life she wants</span
        >
      </h1>

      <p
        class="text-[#333D29]/75 text-base sm:text-lg leading-relaxed mb-8 max-w-md font-sans"
      >
        Between managing late nights and growing your vision, your numbers
        shouldn't feel overwhelming. Get custom financial tracking built
        completely around your life, your business, and your goals.
      </p>

      <div class="flex flex-col sm:flex-row sm:items-center gap-5">
        <a
          href="#cta"
          class="inline-block text-center bg-[#A36A52] text-[#FDFBF7] font-medium text-sm tracking-wide
            px-8 py-3.5 hover:bg-[#8F5942] transition-colors duration-300
            rounded-tl-2xl rounded-br-2xl
            focus-visible:outline focus-visible:outline-2
            focus-visible:outline-offset-2 focus-visible:outline-[#A36A52]"
        >
          Book your FREE consult
        </a>

        <p
          class="text-[#333D29]/70 text-xs sm:text-sm leading-snug font-sans max-w-[240px]"
        >
          Join local independent business owners who found clarity in their
          books.
        </p>
      </div>
    </div>

    <div
      class="flex-1 flex items-center justify-center w-full max-w-sm md:max-w-md lg:max-w-lg"
      aria-hidden="true"
    >
      <div
        class="relative w-full aspect-[4/5] sm:aspect-[1] md:aspect-[4/5] max-h-[480px]"
      >
        <div
          class="absolute inset-0 bg-[#333D29]/5 rounded-bl-[4rem] rounded-tr-[4rem] transform translate-x-3 translate-y-3"
        >
        </div>

        <div
          class="absolute inset-0 bg-[#FEFEFE] rounded-tl-[6rem] rounded-br-[6rem] overflow-hidden border border-[#333D29]/10 shadow-sm"
        >
          <img
            src="/Hero/Hero 1.png"
            alt="Queenie's Bookkeeping lifestyle workspace scene"
            class="absolute inset-0 w-full h-full object-cover img-1"
          />

          <img
            src="/Hero/Hero 2.jpg"
            alt="Queenie's Bookkeeping client consultation detail"
            class="absolute inset-0 w-full h-full object-cover img-2"
          />

          <img
            src="/Hero/Hero 3.jpg"
            alt="Featured workspace portrait detail"
            class="absolute inset-0 w-full h-full object-cover img-3"
          />

          <img
            src="/Hero/Hero 4.jpg"
            alt="Strategic layout workspace details"
            class="absolute inset-0 w-full h-full object-cover img-4"
          />
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  /**
   * 4 Images Total × 15 Seconds Each = 60 Seconds Total Loop Duration.
   * Each slide controls a clean 25% slice of the overall timeline grid layout.
   * Opacity transitions safely crossfade at fractional boundaries to protect performance.
   */
  @keyframes cycle-img-1 {
    0%,
    23%,
    98%,
    100% {
      opacity: 1;
      z-index: 10;
    }
    25%,
    96% {
      opacity: 0;
      z-index: 0;
    }
  }
  @keyframes cycle-img-2 {
    0%,
    23%,
    48%,
    100% {
      opacity: 0;
      z-index: 0;
    }
    25%,
    46% {
      opacity: 1;
      z-index: 10;
    }
  }
  @keyframes cycle-img-3 {
    0%,
    48%,
    73%,
    100% {
      opacity: 0;
      z-index: 0;
    }
    50%,
    71% {
      opacity: 1;
      z-index: 10;
    }
  }
  @keyframes cycle-img-4 {
    0%,
    73%,
    98% {
      opacity: 0;
      z-index: 0;
    }
    75%,
    96% {
      opacity: 1;
      z-index: 10;
    }
  }

  .img-1 {
    animation: cycle-img-1 60s infinite ease-in-out;
  }
  .img-2 {
    animation: cycle-img-2 60s infinite ease-in-out;
  }
  .img-3 {
    animation: cycle-img-3 60s infinite ease-in-out;
  }
  .img-4 {
    animation: cycle-img-4 60s infinite ease-in-out;
  }
</style>
