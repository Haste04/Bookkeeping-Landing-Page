---
/**
 * src/components/Footer.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Section 7 — Semantic Footer.
 * Layout: 5-column grid — brand | links ×3 | intentional newsletter form.
 * ─────────────────────────────────────────────────────────────────────────────
 */

const linkColumns = [
  {
    heading: "Services",
    links: [
      { label: "Monthly Bookkeeping", href: "/#features" },
      { label: "Financial Reporting", href: "/#features" },
      { label: "QuickBooks / Xero Management", href: "/#features" },
      { label: "Systems Automation", href: "/#features" },
    ],
  },
  {
    heading: "Studio",
    links: [
      { label: "Our Story", href: "/#about" },
      { label: "The Process", href: "/#features" },
      { label: "Client Stories", href: "/#testimonials" },
    ],
  },
  {
    heading: "Resources",
    links: [
      { label: "Privacy Policy", href: "/PrivacyPolicy" },
      { label: "Terms of Service", href: "/Terms" },
      { label: "Contact Desk", href: "/#cta" },
    ],
  },
] as const;
---

<div class="w-full bg-[#FDFBF7]">
  <footer
    id="footer"
    aria-label="Site footer context"
    class="border-t border-[#333D29]/10 px-6 py-16 md:px-12 lg:px-20 max-w-screen-xl mx-auto"
  >
    <div
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-10 lg:gap-12"
    >
      <!-- Brand column -->
      <div
        class="col-span-2 sm:col-span-3 lg:col-span-2 flex flex-col justify-between pr-0 lg:pr-8"
      >
        <div>
          <a
            href="/"
            class="text-[#333D29] font-serif font-normal text-2xl tracking-wide block mb-3 focus:outline-none"
            aria-label="Seek First Books Home"
          >
            Seek First <span class="italic text-[#A36A52]">Books</span>
          </a>
          <p
            class="text-[#333D29]/70 text-sm leading-relaxed max-w-xs font-sans"
          >
            At Seek First Books, we provide accurate bookkeeping and efficient
            financial systems that reduce stress, improve organisation, and
            support sustainable business growth.
          </p>
        </div>
      </div>

      <!-- Link columns -->
      {
        linkColumns.map(({ heading, links }) => (
          <nav aria-label={`${heading} links`}>
            <h3 class="font-sans font-semibold text-[#333D29] tracking-wider uppercase text-xs mb-4">
              {heading}
            </h3>
            <ul class="space-y-2.5 text-sm font-sans">
              {links.map(({ label, href }) => (
                <li>
                  <a
                    href={href}
                    class="text-[#333D29]/80 hover:text-[#A36A52] transition-colors duration-200"
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-12 pt-8 border-t border-[#333D29]/10 flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <p class="text-[#333D29]/50 text-xs font-sans text-center sm:text-left">
        &copy; <span id="footer-current-year">2026</span> Seek First Books. All rights
        reserved.
      </p>
      <div class="flex items-center gap-6 text-[#333D29]/40 text-xs font-sans">
        <span>2 Corinthians 8:21</span>
        <span>Made with Astro</span>
      </div>
    </div>
  </footer>
</div>

<script>
  function updateFooterYear() {
    const yearSpan = document.getElementById("footer-current-year");
    if (yearSpan) yearSpan.textContent = new Date().getFullYear().toString();
  }
  updateFooterYear();
  document.addEventListener("astro:after-swap", updateFooterYear);
</script>
