---
/**
 * src/components/CTA.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Section 6 — Final Call To Action.
 * Layout: Full-width deep forest background — tagline · headline · premium pill CTA · contact paths.
 * ─────────────────────────────────────────────────────────────────────────────
 */

interface Props {
  tagline?: string;
  headline?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  tagline = "SELECT AN INTENTIONAL PARTNER FOR YOUR BUSINESS DEPTH",
  headline = "Ready to transition from financial overwhelm to absolute clarity?",
  ctaLabel = "Book an Intentional Consultation",
  ctaHref = "mailto:seekfirstbooks@gmail.com",
} = Astro.props;

// Contact Links & Details
const contactDetails = {
  email: {
    label: "seekfirstbooks@gmail.com",
    href: "https://gmail.com/",
  },
  whatsapp: {
    label: "+63 917 565 6032",
    href: "https://wa.me/639175656032",
  },
  socials: [
    {
      label: "LinkedIn",
      href: "https://www.linkedin.com/in/queenie-mae-abucejo-jd-3aa746113/",
    },
    {
      label: "Facebook",
      href: "https://www.facebook.com/flowerarrangementsbyaqueen",
    },
  ],
};
---

<div class="w-full bg-[#333D29]">
  <section
    id="cta"
    aria-labelledby="cta-headline"
    class="px-6 py-20 md:px-12 lg:px-20 max-w-screen-xl mx-auto"
  >
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center gap-6">
      <p
        class="text-[#A36A52] text-xs sm:text-sm tracking-[0.2em] uppercase font-sans font-semibold"
      >
        {tagline}
      </p>

      <h2
        id="cta-headline"
        class="text-3xl sm:text-4xl md:text-5xl font-serif font-normal leading-[1.2] text-[#FDFBF7]"
      >
        {
          headline.includes("absolute clarity?") ? (
            <>
              Ready to transition from financial overwhelm to{" "}
              <span class="italic text-[#A36A52]">absolute clarity?</span>
            </>
          ) : (
            headline
          )
        }
      </h2>

      <p
        class="text-[#FDFBF7]/80 text-sm sm:text-base font-sans max-w-xl leading-relaxed mb-2"
      >
        We'd love to hear from you. Reach out anytime!
      </p>

      <a
        href={ctaHref}
        class="inline-block bg-[#A36A52] text-[#FDFBF7] font-sans font-medium text-sm tracking-wide
          px-8 py-4 rounded-tl-xl rounded-br-xl rounded-tr-sm rounded-bl-sm
          hover:bg-[#A36A52]/90 hover:shadow-md transition-all duration-300 transform hover:-translate-y-0.5
          focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#A36A52] focus-visible:ring-offset-[#333D29]"
      >
        {ctaLabel}
      </a>

      <div class="w-24 h-px bg-[#FDFBF7]/20 my-4"></div>

      <div class="flex flex-col items-center gap-5 w-full font-sans">
        <div class="flex flex-col items-center">
          <span
            class="text-[#A36A52] text-xs uppercase tracking-widest font-semibold mb-1"
            >Email</span
          >
          <a
            href={`mailto:${contactDetails.email.href}`}
            class="text-[#FDFBF7] text-sm sm:text-base hover:text-[#A36A52] transition-colors duration-200"
          >
            {contactDetails.email.label}
          </a>
        </div>

        <div class="flex flex-col items-center">
          <span
            class="text-[#A36A52] text-xs uppercase tracking-widest font-semibold mb-1"
            >WhatsApp</span
          >
          <a
            href={contactDetails.whatsapp.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#FDFBF7] text-sm sm:text-base hover:text-[#A36A52] transition-colors duration-200"
          >
            {contactDetails.whatsapp.label}
          </a>
        </div>

        <div class="flex flex-col items-center mt-2">
          <span
            class="text-[#A36A52] text-xs uppercase tracking-widest font-semibold mb-3"
            >Connect With Us</span
          >
          <div class="flex items-center gap-4">
            {
              contactDetails.socials.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block bg-white/10 hover:bg-[#A36A52] text-[#FDFBF7] text-sm font-medium tracking-wide py-2 px-6 rounded-full transition-all duration-300 hover:shadow-sm"
                >
                  {social.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
