---
/**
 * src/components/NavBar.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Global site navigation — Boutique Earth Theme.
 * Sticky positioning is handled by the <header> in index.astro.
 * ─────────────────────────────────────────────────────────────────────────────
 */

const navLinks = [
  { label: "Features", href: "#features" },
  { label: "How It Works", href: "#value-prop" },
  { label: "Reviews", href: "#testimonials" },
  { label: "FAQ", href: "#faq" },
  { label: "Contact", href: "#footer" },
] as const;
---

<nav
  aria-label="Primary navigation"
  class="flex items-center justify-between px-6 py-6 md:px-12 lg:px-20 border-b border-[#333D29]/5 bg-[#FDFBF7]"
>
  <a
    href="/"
    aria-label="Queenie's Bookkeeping Home"
    class="flex items-center gap-3 shrink-0"
  >
    <span
      class="text-[#333D29] font-medium text-lg sm:text-xl tracking-[0.12em] font-serif"
    >
      QUEENIE'S BOOKKEEPING
    </span>
  </a>

  <ul
    class="hidden md:flex items-center gap-6 lg:gap-8 text-xs sm:text-sm font-medium tracking-wide text-[#333D29]/90"
  >
    {
      navLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="hover:text-[#A36A52] transition-colors duration-200"
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>

  <button
    class="md:hidden flex flex-col gap-1.5 p-2 focus:outline-none"
    aria-label="Open mobile menu"
    aria-expanded="false"
  >
    <span class="block w-6 h-0.5 bg-[#333D29]"></span>
    <span class="block w-6 h-0.5 bg-[#333D29]"></span>
    <span class="block w-4 h-0.5 bg-[#333D29]"></span>
  </button>
</nav>
