---
/**
 * src/components/FAQ.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Section 5 — FAQ / Handling Objections.
 * Layout: left-aligned/centered organic header block + refined <details> accordion stack.
 * Pure-CSS accordion — arrow rotation handled dynamically with Tailwind group utilities.
 * ─────────────────────────────────────────────────────────────────────────────
 */

interface FAQItem {
  question: string;
  answer: string;
}

const faqs: FAQItem[] = [
  {
    question: "How does the custom bookkeeping setup process look like?",
    answer:
      "We begin with an intentional review of your current systems during our consultation. From there, I build a custom, organized financial workflow mapped closely to your specific creative routines so you can say goodbye to messy spreadsheets.",
  },
  {
    question: "I am far behind on my books. Can you help me catch up?",
    answer:
      "Absolutely. There is zero judgment here. We can handle complete multi-month or full-year financial catch-ups, matching up mixed receipts and bank balances to get your records fully organized, accurate, and tax-ready.",
  },
  {
    question:
      "What financial software or tools do you design workflows around?",
    answer:
      "I customize tracking methods around clean modern frameworks like QuickBooks Online or specialized digital ledgers depending on your business model—ensuring your automation works beautifully without any complex tech jargon.",
  },
  {
    question: "How do monthly financial health check-ins work?",
    answer:
      "At the close of every month, you receive a beautifully clear, tailored profit summary breakdown. We review your actual cash flow trends and true profitability, giving you complete peace of mind to focus purely on expanding your business.",
  },
  {
    question: "Can you work directly with my CPA for tax season filing?",
    answer:
      "Yes, seamlessly. When tax season arrives, I provide organized, fully reconciled statements and asset reports directly to your CPA, making the entire annual transition stress-free and smooth.",
  },
];
---

<div class="w-full bg-[#FDFBF7]">
  <section
    id="faq"
    aria-labelledby="faq-headline"
    class="px-6 py-16 md:px-12 lg:px-20 max-w-screen-xl mx-auto"
  >
    <div class="max-w-xl mx-auto text-center mb-16">
      <h2
        id="faq-headline"
        class="text-3xl sm:text-4xl font-serif font-normal leading-[1.25] text-[#333D29] mb-4"
      >
        Answering your <span class="italic text-[#A36A52]"
          >frequently asked questions</span
        >
      </h2>
      <p
        class="text-[#333D29]/70 text-sm sm:text-base font-sans leading-relaxed"
      >
        Let’s bring absolute clarity to how we partner together. Here is exactly
        what you can expect when organizing your business financial systems.
      </p>
    </div>

    <div
      class="max-w-3xl mx-auto divide-y divide-[#333D29]/10 border-b border-[#333D29]/10"
      role="list"
      aria-label="Frequently asked questions list"
    >
      {
        faqs.map(({ question, answer }) => (
          <details
            class="group py-5 transition-colors duration-200"
            role="listitem"
          >
            <summary
              class="
              flex items-center justify-between
              cursor-pointer list-none
              text-[#333D29] font-medium text-base sm:text-lg gap-4
              hover:text-[#A36A52] transition-colors focus:outline-none select-none
            "
            >
              <span class="font-sans font-medium tracking-wide">
                {question}
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="w-5 h-5 shrink-0 text-[#A36A52] transition-transform duration-300 transform group-open:rotate-90"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <polyline
                  points="9 18 15 12 9 6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <div class="pt-3 pb-2 text-[#333D29]/75 text-sm sm:text-base leading-relaxed font-sans max-w-2xl">
              {answer}
            </div>
          </details>
        ))
      }
    </div>
  </section>
</div>

<style>
  /* Hide native summary marker arrows cleanly across alternative webkit engine browsers */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
