---
/**
 * src/components/FAQ.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Section 5 — FAQ / Handling Objections.
 * Layout: left-aligned/centered organic header block + refined <details> accordion stack.
 * Pure-CSS accordion — arrow rotation handled dynamically with Tailwind group utilities.
 * ─────────────────────────────────────────────────────────────────────────────
 */

interface FAQItem {
  question: string;
  answer: string;
}

const faqs: FAQItem[] = [
  {
    question: "What does the Essential Bookkeeping & Setup process involve?",
    answer:
      "We begin with an intentional review of your current systems during our initial consultation. From there, I build a personalized Chart of Accounts mapped to your specific revenue streams, handle recurring bank and credit card reconciliations, and eliminate messy spreadsheets so you can have complete peace of mind.",
  },
  {
    question: "I am months behind on my records. Can you help me catch up?",
    answer:
      "Absolutely. Our Catch-Up & Clean-Up Bookkeeping service is designed for exactly this situation with zero judgment. We will retroactively resolve backlogged records, organize mixed receipts, balance ledger accounts, and get your multi-month or full-year financial history completely accurate and tax-ready.",
  },
  {
    question:
      "What platforms or tools do you integrate into financial workflows?",
    answer:
      "We build clean, automated digital systems by syncing your financial ledgers with modern tools like QuickBooks Online, automated invoice management platforms, and cloud-based receipt-digitization apps. We can also integrate e-commerce storefronts, point-of-sale (POS) terminals, and merchant gateways to keep everything unified.",
  },
  {
    question: "How do monthly financial summaries and health check-ins work?",
    answer:
      "At the close of every month, you receive a beautifully clear, tailored profit summary breakdown. We will look beyond just the raw numbers to review actual cash flow trends, track resource efficiency metrics, and evaluate true profitability so you can focus entirely on sustainable business growth.",
  },
  {
    question: "Do you handle annual tax filing, or work directly with my CPA?",
    answer:
      "While we focus on precise day-to-day accounting, systems automation, and clean ledgers, we partner seamlessly with your tax professional. When tax season arrives, I provide organized, fully reconciled financial statements and asset reports directly to your CPA, making the annual transition stress-free and smooth.",
  },
];
---

<div class="w-full bg-[#FDFBF7]">
  <section
    id="faq"
    aria-labelledby="faq-headline"
    class="px-6 py-16 md:px-12 lg:px-20 max-w-screen-xl mx-auto"
  >
    <div class="max-w-xl mx-auto text-center mb-16">
      <h2
        id="faq-headline"
        class="text-3xl sm:text-4xl font-serif font-normal leading-[1.25] text-[#333D29] mb-4"
      >
        Answering your <span class="italic text-[#A36A52]"
          >frequently asked questions</span
        >
      </h2>
      <p
        class="text-[#333D29]/70 text-sm sm:text-base font-sans leading-relaxed"
      >
        Let’s bring absolute clarity to how we partner together. Here is exactly
        what you can expect when organizing your business financial systems.
      </p>
    </div>

    <div
      class="max-w-3xl mx-auto divide-y divide-[#333D29]/10 border-b border-[#333D29]/10"
      role="list"
      aria-label="Frequently asked questions list"
    >
      {
        faqs.map(({ question, answer }) => (
          <details
            class="group py-5 transition-colors duration-200"
            role="listitem"
          >
            <summary
              class="
              flex items-center justify-between
              cursor-pointer list-none
              text-[#333D29] font-medium text-base sm:text-lg gap-4
              hover:text-[#A36A52] transition-colors focus:outline-none select-none
            "
            >
              <span class="font-sans font-medium tracking-wide">
                {question}
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="w-5 h-5 shrink-0 text-[#A36A52] transition-transform duration-300 transform group-open:rotate-90"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <polyline
                  points="9 18 15 12 9 6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <div class="pt-3 pb-2 text-[#333D29]/75 text-sm sm:text-base leading-relaxed font-sans max-w-2xl">
              {answer}
            </div>
          </details>
        ))
      }
    </div>
  </section>
</div>

<style>
  /* Hide native summary marker arrows cleanly across alternative webkit engine browsers */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
