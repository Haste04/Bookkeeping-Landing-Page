---
/**
 * src/components/ValueProp.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Section 3 — Graphic Detail Value Proposition.
 * Layout: reverse 2-column — framing visual left, copy + custom checklist right.
 * Boutique aesthetic featuring organic lines, editorial serifs, and full-bleed bounds.
 * ─────────────────────────────────────────────────────────────────────────────
 */

const checkItems = [
  "Custom-built bookkeeping templates that work around your daily life",
  "On-demand profit summaries delivered with absolute aesthetic clarity",
  "A trusted financial partner helping you protect your creative energy",
];
---

<div class="w-full bg-[#FDFBF7]">
  <section
    id="value-prop"
    aria-labelledby="value-prop-headline"
    class="px-6 py-16 md:px-12 lg:px-20 max-w-screen-xl mx-auto"
  >
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-16">
      <div
        class="flex-1 flex items-center justify-center w-full"
        aria-hidden="true"
      >
        <div
          class="relative w-full max-w-sm aspect-[4/5] bg-[#333D29]/5 rounded-tl-[5rem] rounded-br-[2rem] p-6 flex items-center justify-center border border-[#333D29]/10"
        >
          <div
            class="absolute inset-4 border border-dashed border-[#333D29]/10 rounded-tl-[4rem] rounded-br-[1.5rem]"
          >
          </div>

          <div class="text-center z-10 px-6">
            <svg
              viewBox="0 0 24 24"
              class="w-10 h-10 text-[#A36A52]/30 mx-auto mb-3"
              fill="none"
              stroke="currentColor"
              stroke-width="1"
            >
              <path
                d="M12 22V2M12 12c0-3.314 2.686-6 6-6M12 17c-3.314 0-6-2.686-6-6"
                stroke-linecap="round"></path>
            </svg>
            <span
              class="block text-xs tracking-[0.15em] uppercase font-serif text-[#333D29]/50"
            >
              Financial Architecture / Brand Context Visual
            </span>
          </div>
        </div>
      </div>

      <div class="flex-1 max-w-lg flex flex-col justify-center">
        <h2
          id="value-prop-headline"
          class="text-3xl sm:text-4xl font-serif font-normal leading-[1.25] text-[#333D29] mb-5"
        >
          Designed for numbers, <span class="italic text-[#A36A52]"
            >tailored for peace of mind</span
          >.
        </h2>

        <p
          class="text-[#333D29]/75 text-sm sm:text-base leading-relaxed mb-8 font-sans"
        >
          Your business financial system shouldn't require an extra degree to
          interpret. We clean up historical disorganization, build streamlined
          workflows, and give you back the processing hours needed to focus
          completely on scaling your beautiful visions.
        </p>

        <ul class="space-y-4 text-[#333D29]/90 text-sm font-sans">
          {
            checkItems.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 shrink-0 text-[#A36A52]" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <polyline
                      points="20 6 9 17 4 12"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</div>
