---
/**
 * src/components/ValueProp.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Section 3 — Graphic Detail Value Proposition.
 * Layout: reverse 2-column — phone frame left, copy + checklist right.
 * ─────────────────────────────────────────────────────────────────────────────
 */

const checkItems = [
  'Showcase and embed your work with',
  'Publish across social channels in a click',
  'Sell your videos worldwide',
];
---

<section
  id="value-prop"
  aria-labelledby="value-prop-headline"
  class="px-6 py-16 md:px-12 lg:px-20 max-w-screen-xl mx-auto"
>
  <div class="flex flex-col md:flex-row items-stretch gap-12 md:gap-16">

    <!-- ── Left: app / mobile screen mock ────────────────────────────────── -->
    <div
      class="
        flex-1 flex items-center justify-center
        bg-blue-50 rounded-2xl
        min-h-[320px] md:min-h-[440px]
        max-w-md w-full p-6
      "
      aria-hidden="true"
    >
      <!--
        ╔══ SCREEN MOCK PLACEHOLDER ══════════════════════════════════════════╗
        ║  Replace this SVG with a real product screenshot wrapped in:        ║
        ║    <Image src={import('../assets/app-screen.png')} alt="App UI" />  ║
        ╚═════════════════════════════════════════════════════════════════════╝
      -->
      <svg
        viewBox="0 0 220 400"
        xmlns="http://www.w3.org/2000/svg"
        class="h-full max-h-[380px] w-auto"
        aria-label="Mobile app screen placeholder"
      >
        <!-- Phone outline -->
        <rect x="10" y="10" width="200" height="380" rx="22"
              fill="#F8FAFF" stroke="#2563EB" stroke-width="2"/>
        <!-- Notch -->
        <rect x="70" y="14" width="80" height="18" rx="9"
              fill="#EFF6FF" stroke="#2563EB" stroke-width="1.5"/>
        <!-- Screen content rows -->
        <rect x="28" y="54"  width="164" height="14" rx="4" fill="#DBEAFE"/>
        <rect x="28" y="76"  width="120" height="10" rx="4" fill="#BFDBFE"/>
        <rect x="28" y="106" width="164" height="60" rx="6" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="1"/>
        <rect x="28" y="176" width="164" height="60" rx="6" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="1"/>
        <rect x="28" y="246" width="164" height="60" rx="6" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="1"/>
        <!-- Home indicator -->
        <rect x="80" y="368" width="60" height="5" rx="3" fill="#BFDBFE"/>
      </svg>
    </div>

    <!-- ── Right: copy + checklist ───────────────────────────────────────── -->
    <div class="flex-1 max-w-lg flex flex-col justify-center">
      <h2
        id="value-prop-headline"
        class="text-2xl sm:text-3xl font-extrabold leading-snug text-blue-600 mb-4"
      >
        Long headline on two lines to turn your visitors into users and achieve more
      </h2>

      <p class="text-blue-600/75 text-sm leading-relaxed mb-6">
        Separated they live in Bookmarks right at the coast of the famous
        Semantics, large language ocean. Separated they live in Bookmarks
        right at the coast.
      </p>

      <!-- Checkmark list -->
      <ul class="space-y-3 text-blue-600 text-sm">
        {checkItems.map((item) => (
          <li class="flex items-center gap-3">
            <!-- Circled checkmark — swap with your icon library if preferred -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="w-5 h-5 shrink-0 text-blue-600"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"/>
              <polyline points="8,12 11,15 16,9" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {item}
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>