---
/**
 * src/components/ValueProp.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Section 3 — Graphic Detail Value Proposition.
 * Layout: reverse 2-column — framing visual left, copy + custom checklist right.
 * Boutique aesthetic featuring organic lines, editorial serifs, and full-bleed bounds.
 * ─────────────────────────────────────────────────────────────────────────────
 */

const checkItems = [
  "Custom-built bookkeeping templates that work around your daily life",
  "On-demand profit summaries delivered with absolute aesthetic clarity",
  "A trusted financial partner helping you protect your creative energy",
];
---

<div class="w-full bg-[#FDFBF7] relative overflow-hidden">
  <div class="absolute inset-0 w-full h-full z-0 pointer-events-none">
    <img
      src="/ValueProp/ValueProp Background.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      role="presentation"
      decoding="async"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-[#FDFBF7]/85 backdrop-blur-[2px]"></div>
  </div>

  <section
    id="value-prop"
    aria-labelledby="value-prop-headline"
    class="px-6 py-16 md:px-12 lg:px-20 max-w-screen-xl mx-auto relative z-10"
  >
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-16">
      <div
        class="flex-1 flex items-center justify-center w-full"
        aria-hidden="true"
      >
        <div
          class="relative w-full max-w-sm aspect-[4/5] rounded-tl-[5rem] rounded-br-[2rem] overflow-hidden border border-[#333D29]/10 shadow-sm"
        >
          <img
            src="/ValueProp/ValueProp 1.jpg"
            alt="Seek First Books detailed visual workspace asset presentation"
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <div class="flex-1 max-w-lg flex flex-col justify-center">
        <h2
          id="value-prop-headline"
          class="text-3xl sm:text-4xl font-serif font-normal leading-[1.25] text-[#333D29] mb-5"
        >
          SPECIALIZED PROJECT <span class="italic text-[#A36A52]">SERVICES</span
          >
        </h2>

        <p
          class="text-[#333D29]/75 text-sm sm:text-base leading-relaxed mb-8 font-sans"
        >
          Beyond our monthly packages, we offer specialized project services
          designed to establish, restore, or enhance your financial systems.
          Each service is tailored to your unique business needs with
          transparent pricing and dedicated expertise.
        </p>

        <ul class="space-y-4 text-[#333D29]/90 text-sm font-sans">
          {
            checkItems.map((item) => (
              <li class="flex items-start gap-3 group">
                <span
                  class="mt-0.5 shrink-0 text-[#A36A52] transform group-hover:scale-110 transition-transform duration-200"
                  aria-hidden="true"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <polyline
                      points="20 6 9 17 4 12"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <span class="transition-colors duration-200 group-hover:text-[#333D29]">
                  {item}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</div>
