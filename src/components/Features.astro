---
/**
 * src/components/Features.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Section 2 — Features & Benefits.
 * Displays custom premium accounting service cards and an interactive, structured
 * horizontal step-by-step roadmap outlining the client onboarding pathway.
 * ─────────────────────────────────────────────────────────────────────────────
 */

const features = [
  {
    title: "Monthly Bookkeeping",
    description:
      "Comprehensive monthly accounting, transaction categorization, bank reconciliations, and accurate financial statements delivered with care.",
    iconShape: "bookOpen",
  },
  {
    title: "Financial Reporting",
    description:
      "Clear, actionable financial reports that give you insights into your business performance and support informed decision-making.",
    iconShape: "trendingUp",
  },
  {
    title: "QuickBooks / Xero Management",
    description:
      "Expert setup, optimization, and ongoing management of your QuickBooks account to ensure seamless financial tracking.",
    iconShape: "monitorCheck",
  },
  {
    title: "Systems Automation",
    description:
      "Streamlined workflow automations and integrations that save time, reduce errors, and let you focus on growing your business.",
    iconShape: "settingsGear",
  },
] as const;

const steps = [
  {
    num: "1",
    title: "Free Quick Connect",
    description:
      "A brief introductory call to understand your business needs and determine if we're the right fit for your financial goals.",
  },
  {
    num: "2",
    title: "Onboarding",
    description:
      "We gather your financial documents, access credentials, and learn your unique workflows to create a tailored approach.",
  },
  {
    num: "3",
    title: "Setup & Repair",
    description:
      "We organize your books, fix past issues, and implement efficient systems designed for your business.",
  },
  {
    num: "4",
    title: "Routine & Flourish",
    description:
      "Ongoing monthly support keeps your finances clear and organized so you can focus on growth.",
  },
] as const;
---

<div class="w-full bg-[#FDFBF7]">
  <section
    id="features"
    aria-labelledby="features-headline"
    class="px-6 py-16 md:px-12 lg:px-20 max-w-screen-xl mx-auto"
  >
    <div
      class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-14 mb-24 max-w-5xl mx-auto"
    >
      {
        features.map(({ title, description, iconShape }) => (
          <article class="flex items-start gap-5 group">
            <div
              class="w-14 h-14 flex items-center justify-center shrink-0 
                     bg-[#333D29]/5 text-[#A36A52] rounded-tl-xl rounded-br-xl 
                     group-hover:bg-[#A36A52]/10 transition-colors duration-300"
              aria-hidden="true"
            >
              {iconShape === "bookOpen" && (
                <svg
                  viewBox="0 0 24 24"
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                </svg>
              )}
              {iconShape === "trendingUp" && (
                <svg
                  viewBox="0 0 24 24"
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                  <polyline points="17 6 23 6 23 12" />
                </svg>
              )}
              {iconShape === "monitorCheck" && (
                <svg
                  viewBox="0 0 24 24"
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                  <line x1="8" y1="21" x2="16" y2="21" />
                  <line x1="12" y1="17" x2="12" y2="21" />
                  <polyline points="9 10 11 12 15 8" />
                </svg>
              )}
              {iconShape === "settingsGear" && (
                <svg
                  viewBox="0 0 24 24"
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="3" />
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                </svg>
              )}
            </div>

            <div class="flex flex-col gap-1.5">
              <h3 class="font-serif font-medium text-[#333D29] text-xl tracking-wide transition-colors duration-200 group-hover:text-[#A36A52]">
                {title}
              </h3>
              <p class="text-[#333D29]/75 text-sm leading-relaxed font-sans">
                {description}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="w-full pt-8 border-t border-[#333D29]/10">
      <div
        class="max-w-xl md:max-w-none mx-auto mb-16 text-center md:text-left"
      >
        <h2
          id="features-headline"
          class="text-3xl sm:text-4xl font-serif font-normal leading-[1.25] text-[#333D29]"
        >
          How we <span class="italic text-[#A36A52]">Work</span>
        </h2>
      </div>

      <div class="relative w-full max-w-5xl mx-auto mt-12">
        <div
          class="hidden md:block absolute top-[26px] left-4 right-12 h-[2px] bg-[#333D29]/20"
          aria-hidden="true"
        >
          <div
            class="absolute -right-2 -top-[4px] w-0 h-0 border-y-[5px] border-y-transparent border-l-[8px] border-l-[#333D29]/30"
          >
          </div>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-6 relative z-10"
        >
          {
            steps.map(({ num, title, description }) => (
              <div class="flex flex-col items-center md:items-start text-center md:text-left group">
                <div class="relative flex items-center justify-center w-14 h-14 rounded-full bg-[#EAE5DA] border border-[#333D29]/10 text-[#333D29] font-serif text-lg mb-5 shadow-sm group-hover:bg-[#A36A52] group-hover:text-[#FDFBF7] transition-colors duration-300">
                  {num}
                  <div class="absolute -top-1.5 w-2 h-2 rounded-full bg-[#333D29]/40 hidden md:block" />
                </div>

                <h3 class="font-serif font-medium text-[#333D29] text-lg tracking-wide mb-2 group-hover:text-[#A36A52] transition-colors duration-200">
                  {title}
                </h3>
                <p class="text-[#333D29]/75 text-xs sm:text-sm leading-relaxed font-sans max-w-xs">
                  {description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</div>
