---
/**
 * src/components/Testimonials.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Section 4 — Social Proof & Testimonials Carousel.
 * Layout/placement: same carousel structure as before.
 * Theme: dark olive green background matching the CTA section palette.
 * Spotlight mode: active card sharp, inactive cards blurred + dimmed.
 * ─────────────────────────────────────────────────────────────────────────────
 */

interface Testimonial {
  quote: string;
  name: string;
  description: string;
  avatarSrc: string;
}

const testimonials: Testimonial[] = [
  {
    quote:
      '"Great experience working with them. They caught several errors we had overlooked and helped keep our books accurate."',
    name: "Jotham",
    description: "Satisfied Client",
    avatarSrc: "",
  },
  {
    quote:
      '"Reliable bookkeeping support and excellent communication. I always know where our finances stand."',
    name: "Chris",
    description: "Satisfied Client",
    avatarSrc: "",
  },
  {
    quote:
      '"I used to spend hours trying to keep our books updated. Now I can focus on running the business knowing our finances are in good hands."',
    name: "Kim",
    description: "Satisfied Client",
    avatarSrc: "",
  },
];

const showCarouselControls = testimonials.length > 1;
---

<!-- Dark olive green background to match the overall site palette -->
<div class="w-full bg-[#333D29] overflow-hidden">
  <section
    id="testimonials"
    aria-labelledby="testimonials-headline"
    class="px-6 py-16 md:px-12 lg:px-20 max-w-screen-xl mx-auto relative"
  >

    <!-- Header row: headline left, arrow controls right -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12">
      <div class="max-w-3xl lg:max-w-none">
        <h2
          id="testimonials-headline"
          class="text-3xl sm:text-4xl font-serif font-normal leading-[1.25] text-[#FDFBF7]"
        >
          Stories from people{" "}
          <span class="italic text-[#A36A52]">who reclaimed their time</span>
        </h2>
      </div>

      {
        showCarouselControls && (
          <div class="flex items-center gap-3 select-none shrink-0">
            <button
              id="prev-testimonial"
              class="w-10 h-10 rounded-full border border-[#FDFBF7]/20 flex items-center justify-center text-[#FDFBF7] hover:bg-[#A36A52] hover:border-[#A36A52] transition-colors duration-300 focus:outline-none"
              aria-label="Previous testimonial"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                   class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="15 18 9 12 15 6" />
              </svg>
            </button>
            <button
              id="next-testimonial"
              class="w-10 h-10 rounded-full border border-[#FDFBF7]/20 flex items-center justify-center text-[#FDFBF7] hover:bg-[#A36A52] hover:border-[#A36A52] transition-colors duration-300 focus:outline-none"
              aria-label="Next testimonial"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                   class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </button>
          </div>
        )
      }
    </div>

    <!-- Slider viewport -->
    <div class="w-full overflow-hidden" id="slider-viewport">
      <div
        id="testimonials-track"
        class="grid grid-flow-col auto-cols-[100%] sm:auto-cols-[calc(50%-12px)] lg:auto-cols-[calc(33.333%-16px)] gap-6 lg:gap-8 transition-transform duration-500 ease-out will-change-transform"
        data-count={testimonials.length}
      >
        {
          testimonials.map(({ quote, name, description, avatarSrc }, index) => (
            <article
              data-card-index={index}
              class="flex flex-col justify-between rounded-tl-2xl rounded-br-2xl p-8 h-full transition-all duration-500"
              style={
                /* Card 0 starts spotlit; others start blurred.
                   Uses a slightly lighter olive tint for the card surface
                   so it reads as a lifted layer against the dark background. */
                index === 0
                  ? "background: rgba(253,251,247,0.07); border: 1px solid rgba(253,251,247,0.12); filter: none; opacity: 1; transform: scale(1);"
                  : "background: rgba(253,251,247,0.07); border: 1px solid rgba(253,251,247,0.12); filter: blur(2px); opacity: 0.35; transform: scale(0.96);"
              }
            >
              <!-- Quote mark -->
              <div>
                <span class="block text-4xl font-serif text-[#A36A52]/50 leading-none mb-1 select-none">
                  "
                </span>
                <blockquote class="text-[#FDFBF7]/80 text-sm leading-relaxed font-sans mb-8">
                  {quote}
                </blockquote>
              </div>

              <!-- Reviewer footer -->
              <footer class="flex items-center gap-4 mt-auto pt-4 border-t border-[#FDFBF7]/10">
                {avatarSrc ? (
                  <img
                    src={avatarSrc}
                    alt={`${name} profile`}
                    class="w-11 h-11 rounded-full object-cover shrink-0 border border-[#FDFBF7]/20"
                    loading="lazy"
                  />
                ) : (
                  <div
                    class="w-11 h-11 rounded-full bg-[#FDFBF7]/10 text-[#A36A52] flex items-center justify-center shrink-0 font-serif text-sm font-medium"
                    aria-hidden="true"
                  >
                    {name.charAt(0)}
                  </div>
                )}
                <div>
                  <p class="text-[#FDFBF7] font-medium text-sm tracking-wide font-sans">
                    {name}
                  </p>
                  <p class="text-[#FDFBF7]/50 text-xs italic font-serif mt-0.5">
                    {description}
                  </p>
                </div>
              </footer>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Pagination dots -->
    <div
      id="pagination-dots"
      class="flex justify-center gap-2.5 mt-10"
      aria-label="Testimonial pagination"
    >
      {
        testimonials.map((_, index) => (
          <button
            class="h-2.5 rounded-full transition-all duration-300 focus:outline-none bg-[#FDFBF7]/20"
            style={index === 0 ? "width:24px; background-color:#A36A52;" : "width:10px;"}
            data-index={index}
            aria-label={`Go to slide ${index + 1}`}
          />
        ))
      }
    </div>

  </section>
</div>

<script>
  function setupTestimonialCarousel() {
    const track   = document.getElementById("testimonials-track") as HTMLDivElement;
    const prevBtn = document.getElementById("prev-testimonial")   as HTMLButtonElement;
    const nextBtn = document.getElementById("next-testimonial")   as HTMLButtonElement;
    const dots    = document.querySelectorAll<HTMLButtonElement>("#pagination-dots button");
    const cards   = document.querySelectorAll<HTMLElement>("[data-card-index]");

    if (!track || cards.length === 0) return;

    const totalItems = cards.length;
    let currentIndex              = 0;
    let autoplayTimer: number | undefined;

    // ── Responsive column count ─────────────────────────────────────────────
    function getVisibleCount(): number {
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 640)  return 2;
      return 1;
    }

    // ── Master update: position + spotlight + dots ──────────────────────────
    function updateCarousel() {
      // Wrap index
      if (currentIndex >= totalItems) currentIndex = 0;
      if (currentIndex < 0)           currentIndex = totalItems - 1;

      const visible = getVisibleCount();

      // Translation — clamped so we never show empty space on the right
      const maxTranslation  = totalItems - visible;
      const translationStep = Math.min(currentIndex, maxTranslation);
      const offsetPercent   = translationStep * (100 / visible);
      track.style.transform = `translateX(-${offsetPercent}%)`;

      // Spotlight — active card sharp, all others blurred + dimmed
      cards.forEach((card, idx) => {
        if (idx === currentIndex) {
          card.style.filter    = "none";
          card.style.opacity   = "1";
          card.style.transform = "scale(1)";
        } else {
          card.style.filter    = "blur(2px)";
          card.style.opacity   = "0.35";
          card.style.transform = "scale(0.96)";
        }
      });

      // Pagination dots — active dot stretches into a capsule
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.style.backgroundColor = "#A36A52";
          dot.style.width           = "24px";
        } else {
          dot.style.backgroundColor = "rgba(253,251,247,0.2)";
          dot.style.width           = "10px";
        }
      });
    }

    // ── Navigation ──────────────────────────────────────────────────────────
    function handleNext() { currentIndex++; updateCarousel(); }
    function handlePrev() { currentIndex--; updateCarousel(); }

    // ── Autoplay (30 seconds) ───────────────────────────────────────────────
    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = window.setInterval(handleNext, 10000);
    }
    function stopAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
    }

    // ── Event listeners ─────────────────────────────────────────────────────
    nextBtn?.addEventListener("click", () => { handleNext(); startAutoplay(); });
    prevBtn?.addEventListener("click", () => { handlePrev(); startAutoplay(); });

    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => {
        currentIndex = idx;
        updateCarousel();
        startAutoplay();
      });
    });

    // Pause on hover so users can read comfortably
    track.addEventListener("mouseenter", stopAutoplay);
    track.addEventListener("mouseleave", startAutoplay);

    // Recalculate on viewport resize
    window.addEventListener("resize", updateCarousel);

    // ── Init ────────────────────────────────────────────────────────────────
    updateCarousel();
    startAutoplay();
  }

  setupTestimonialCarousel();
  document.addEventListener("astro:after-swap", setupTestimonialCarousel);
</script>