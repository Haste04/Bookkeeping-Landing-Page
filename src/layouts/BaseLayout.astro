---
/**
 * src/layouts/BaseLayout.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Global HTML shell shared by every page.
 * ─────────────────────────────────────────────────────────────────────────────
 */
import "../styles/global.css";
// 1. Import the progress bar component
import PageProgressBar from "../components/PageProgressBar.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Seek First Books — Intentional Financial Clarity",
  description = "",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href="/Logo.jpg" />
  </head>

  <body
    class="bg-[#FDFBF7] text-[#333D29] antialiased selection:bg-[#A36A52]/20 selection:text-[#333D29]"
  >
    <PageProgressBar />

    <slot />
  </body>
</html>
